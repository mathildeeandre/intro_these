@article{gonzalez_asymptotic_2022,
	title = {Asymptotic moments of spatial branching processes},
	volume = {184},
	issn = {1432-2064},
	url = {https://doi.org/10.1007/s00440-022-01131-2},
	doi = {10.1007/s00440-022-01131-2},
	abstract = {Suppose that \$\$X =(X\_t, t{\textbackslash}ge 0)\$\$is either a superprocess or a branching Markov process on a general space E, with non-local branching mechanism and probabilities \$\$\{{\textbackslash}mathbb \{P\}\}\_\{{\textbackslash}delta \_x\}\$\$, when issued from a unit mass at \$\$x{\textbackslash}in E\$\$. For a general setting in which the first moment semigroup of X displays a Perron–Frobenius type behaviour, we show that, for \$\$k{\textbackslash}ge 2\$\$and any positive bounded measurable function f on E, \$\${\textbackslash}begin\{aligned\} {\textbackslash}lim \_\{t{\textbackslash}rightarrow {\textbackslash}infty \} g\_k(t)\{{\textbackslash}mathbb \{E\}\}\_\{{\textbackslash}delta \_x\}[{\textbackslash}langle f, X\_t{\textbackslash}rangle {\textasciicircum}k] = C\_k(x, f), {\textbackslash}end\{aligned\}\$\$limt→∞gk(t)Eδx[⟨f,Xt⟩k]=Ck(x,f),where the constant \$\$C\_k(x, f)\$\$can be identified in terms of the principal right eigenfunction and left eigenmeasure and \$\$g\_k(t)\$\$is an appropriate deterministic normalisation, which can be identified explicitly as either polynomial in t or exponential in t, depending on whether X is a critical, supercritical or subcritical process. The method we employ is extremely robust and we are able to extract similarly precise results that additionally give us the moment growth with time of \$\${\textbackslash}int \_0{\textasciicircum}t {\textbackslash}langle f, X\_t {\textbackslash}rangle {\textbackslash}mathrm\{d\}s\$\$, for bounded measurable f on E.},
	number = {3},
	journal = {Probability Theory and Related Fields},
	author = {Gonzalez, Isaac and Horton, Emma and Kyprianou, Andreas E.},
	year = {2022},
	pages = {805--858},
}



